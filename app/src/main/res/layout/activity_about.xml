<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/LinearLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".AboutApp">

    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/txt01"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="end"
                android:text="@string/txt01"
                android:textAppearance="?android:textAppearanceMedium" />

            <TextView
                android:id="@+id/txt02"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:textAppearance="?android:textAppearanceMedium"
                tools:text="Hichem Ben Nader" />

            <TextView
                android:id="@+id/txt031"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:autoLink="email"
                android:gravity="end"
                android:text="@string/txt031"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColorLink="#0000FF" />

            <TextView
                android:id="@+id/txt041"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:autoLink="web"
                android:gravity="end"
                android:text="@string/txt041"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColorLink="#0000FF" />

            <View
                android:id="@+id/line33"
                style="?android:attr/listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#736f6f" />

            <TextView
                android:id="@+id/txt06"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt06"
                android:textAppearance="?android:textAppearanceMedium" />

            <TextView
                android:id="@+id/txt07"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt07"
                android:textAppearance="?android:textAppearanceMedium" />

            <TextView
                android:id="@+id/txt08"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt08"
                android:textAppearance="?android:textAppearanceMedium" />

            <!-- Répétez ce modèle pour les autres TextViews (txt09, txt10, etc.) -->
            <TextView
                android:id="@+id/txt09"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt09"
                android:textAppearance="?android:textAppearanceMedium" />

            <TextView
                android:id="@+id/txt10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt10"
                android:textAppearance="?android:textAppearanceMedium" />

            <TextView
                android:id="@+id/txt11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt11"
                android:textAppearance="?android:textAppearanceMedium" />

            <TextView
                android:id="@+id/txt12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt12"
                android:textAppearance="?android:textAppearanceMedium" />

            <TextView
                android:id="@+id/txt13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt13"
                android:textAppearance="?android:textAppearanceMedium" />

            <TextView
                android:id="@+id/txt14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt14"
                android:textAppearance="?android:textAppearanceMedium" />

            <TextView
                android:id="@+id/txt15"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:lineSpacingExtra="4dp"
                android:text="@string/txt15"
                android:textAppearance="?android:textAppearanceMedium" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>